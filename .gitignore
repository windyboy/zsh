# ZSH Cache and Data
.zcompdump*
*.zwc

# Generated Completions
completions/_*
!completions/.gitkeep

# Environment local settings
env/local/*
!env/local/.gitkeep
local.zsh

# Machine-local state: never track (privacy, and keeps git pull --ff-only clean)
.zsh_history
.zsh_sessions/
themes/theme-preference
in-memoria.db*
plans/

# OS specific
.DS_Store
