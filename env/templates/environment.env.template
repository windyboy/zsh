#!/usr/bin/env zsh
# =============================================================================
# User Environment Configuration Template
# Description: Machine-specific environment variables (exports + feature toggles).
# Usage: Copy this file to local/environment.env and modify as needed
#        (cd env && ./init-env.sh)
# Loaded by zshrc BEFORE modules, so keep it to `export`s and toggle flags
# that modules need at load time (e.g. ZSH_ENABLE_PLUGINS).
# PATH additions go in env/local/hosts/<hostname>.env, loaded AFTER modules
# where add_to_path (modules/env.zsh) is available.
#
# Everything below is an EXAMPLE: uncomment / adjust only what this machine
# actually uses. Values already exported by the OS or by tools are best left
# alone (e.g. do not export GOROOT — go auto-detects its root).
# =============================================================================

# =============================================================================
# Development Tool Installation Paths
# =============================================================================

# Go Language Environment (examples — adjust to your install)
# export GOPATH="$HOME/go"
# export GOPROXY="https://proxy.golang.org,direct"   # or a local mirror

# Rust Language Environment (optional mirrors)
# export RUSTUP_DIST_SERVER="https://mirrors.ustc.edu.cn/rust-static"
# export RUSTUP_UPDATE_ROOT="https://mirrors.ustc.edu.cn/rust-static/rustup"

# Android Development Environment
# export ANDROID_HOME="$HOME/Library/Android/sdk"   # macOS
# export ANDROID_SDK_ROOT="$ANDROID_HOME"
# export ANDROID_HOME="$HOME/Android/Sdk"           # Linux

# JavaScript/Node.js Tools
# export BUN_INSTALL="$HOME/.bun"
# export DENO_INSTALL="$HOME/.deno"
# export PNPM_HOME="$HOME/Library/pnpm"             # macOS
# export PNPM_HOME="$HOME/.local/share/pnpm"        # Linux

# Java Development Environment (SDKMAN)
# export SDKMAN_DIR="$HOME/.sdkman"
# if [[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ]]; then
#     source "$SDKMAN_DIR/bin/sdkman-init.sh"
# fi

# =============================================================================
# Package Manager Mirror Configuration (optional; enable only what you need)
# =============================================================================

# Homebrew Mirror
# export HOMEBREW_BREW_GIT_REMOTE="https://mirrors.ustc.edu.cn/brew.git"

# Flutter Mirror
# export PUB_HOSTED_URL="https://pub.flutter-io.cn"
# export FLUTTER_STORAGE_BASE_URL="https://storage.flutter-io.cn"

# Hugging Face Mirror
# export HF_ENDPOINT=https://hf-mirror.com

# =============================================================================
# Feature Toggles (read by modules at load time)
# =============================================================================

# Enable zinit plugins from plugins/core.list (default off; see REFERENCE.md)
export ZSH_ENABLE_PLUGINS=0

# Oh My Posh: off over SSH unless the client exports TERM_PROGRAM (or set
# ZSH_ENABLE_POSH=1). Glyphs that zsh counts as 1 cell and the terminal as 2
# smear typed characters (ls → lls). Force off: ZSH_DISABLE_POSH=1
# export ZSH_DISABLE_POSH=1
# export ZSH_ENABLE_POSH=1
# export ZSH_OMP_TRANSIENT=1

# =============================================================================
# Custom Environment Variables
# =============================================================================

# Example: Custom workspace directory
# export WORKSPACE="$HOME/workspace"

# Example: Custom projects directory
# export PROJECTS="$HOME/projects"

# Example: Custom tools path
# export CUSTOM_TOOLS="$HOME/tools"

# =============================================================================
# End of File Marker
# After modification, reload: source ~/.config/zsh/zshrc
# =============================================================================
